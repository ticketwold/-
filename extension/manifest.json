{
  "manifest_version": 3,
  "name": "양방배팅 (Pinnacle + BTI)",
  "version": "1.0.0",
  "description": "Pinnacle API와 pbc00 BTI 배당을 비교하는 양방배팅 확장 프로그램",
  "permissions": ["storage", "activeTab", "scripting", "tabs", "webNavigation"],
  "host_permissions": [
    "https://pbc00.com/*",
    "https://*.pbc00.com/*",
    "https://www.pinnacle.com/*",
    "https://guest.api.arcadia.pinnacle.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "양방배팅"
  },
  "content_scripts": [
    {
      "matches": ["https://pbc00.com/*", "https://*.pbc00.com/*"],
      "js": ["bti_content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["debug_bti_frames.js"],
      "matches": ["https://pbc00.com/*", "https://*.pbc00.com/*"]
    }
  ]
}
