{
  "manifest_version": 3,
  "name": "양방 베팅 봇",
  "version": "4.0.4",
  "description": "x10x10s.com (10벳) + Polymarket 양방 서치 및 슬립 비교 베팅",
  "permissions": [
    "storage",
    "tabs",
    "scripting",
    "webNavigation"
  ],
  "host_permissions": [
    "*://*.x10x10s.com/*",
    "*://polymarket.com/*",
    "*://*.polymarket.com/*",
    "*://gamma-api.polymarket.com/*",
    "*://*.auremi88.com/*",
    "*://*.bti-sports.com/*",
    "*://*.bti-sports.io/*",
    "*://*.eviran66.com/*",
    "*://*.indonesiawinner.com/*",
    "*://*.jjddgg.com/*",
    "*://*.mervani99.com/*",
    "*://*.pbc00.com/*",
    "*://*.pinnacle.com/*",
    "*://*.live8588.com/*",
    "*://*.fxf774.com/*",
    "*://*.wg88ss.com/*",
    "*://*.zzddqq.com/*",
    "*://*.zzllrrcc33.com/*",
    "*://api.arcadia.pinnacle.com/*",
    "*://guest.api.arcadia.pinnacle.com/*",
    "*://sports-sbomaind-play.zzllrrcc33.com/*",
    "*://sports.zzllrrcc33.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.eviran66.com/*",
        "*://*.mervani99.com/*",
        "*://*.auremi88.com/*",
        "*://*.pinnacle.com/*",
        "*://*.pbc00.com/*",
        "*://*.x10x10s.com/*"
      ],
      "js": [
        "pinnacle_main.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.eviran66.com/*",
        "*://*.mervani99.com/*",
        "*://*.auremi88.com/*",
        "*://*.pinnacle.com/*",
        "*://*.pbc00.com/*",
        "*://*.x10x10s.com/*"
      ],
      "js": [
        "pinnacle_content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.bti-sports.io/*",
        "*://*.bti-sports.com/*",
        "*://*.indonesiawinner.com/*",
        "*://*.live8588.com/*",
        "*://*.fxf774.com/*",
        "*://*.pbc00.com/*",
        "*://*.x10x10s.com/*",
        "*://*.eviran66.com/*",
        "*://*.auremi88.com/*"
      ],
      "js": [
        "bti_content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://polymarket.com/*",
        "*://*.polymarket.com/*"
      ],
      "js": [
        "polymarket_content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://*.zzllrrcc33.com/*",
        "*://sports-sbomaind-play.zzllrrcc33.com/*",
        "*://sports.zzllrrcc33.com/*",
        "*://*.jjddgg.com/*",
        "*://*.zzddqq.com/*",
        "*://wg88ss.com/*",
        "*://*.wg88ss.com/*"
      ],
      "js": [
        "sbobet_content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "양방 봇 (10x10 + Polymarket)"
  }
}
