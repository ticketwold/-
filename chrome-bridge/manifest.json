{
  "manifest_version": 3,
  "name": "arb Chrome Bridge",
  "version": "1.2.8",
  "description": "BC.Game / x10x10s BetSlip bridge for arb-desktop (auto-pairing)",

  "permissions": [
    "tabs",
    "storage",
    "webNavigation"
  ],

  "host_permissions": [
    "*://*.bc.game/*",
    "*://bc.game/*",
    "*://*.x10x10s.com/*",
    "*://x10x10s.com/*",

    "*://*.sptpub.com/*",
    "*://*.betby.com/*",
    "*://*.sptsportscdn.com/*",
    "*://*.biahosted.com/*",
    "*://*.cocoesports.com/*",

    "*://*.sportscenter.com/*",
    "*://*.bti.bet/*",

    "http://127.0.0.1/*"
  ],

  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },

  "content_scripts": [
    {
      "matches": [
        "*://*.bc.game/*",
        "*://bc.game/*",
        "*://*.sptpub.com/*",
        "*://*.betby.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.biahosted.com/*",
        "*://*.cocoesports.com/*"
      ],
      "js": [
        "bet_type_parser.js",
        "frame_scanner.js",
        "debug_trace.js",
        "stake_actions.js",
        "frame_agent.js",
        "content_bc.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "*://*.x10x10s.com/*",
        "*://x10x10s.com/*",
        "*://*.sportscenter.com/*",
        "*://*.bti.bet/*"
      ],
      "js": [
        "bet_type_parser.js",
        "frame_scanner.js",
        "debug_trace.js",
        "stake_actions.js",
        "frame_agent.js",
        "content_x10.js"
      ],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ],

  "action": {
    "default_title": "arb Chrome Bridge"
  }
}
