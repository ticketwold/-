# 양방배팅 프로그램 설정
# cp config/settings.yaml.example config/settings.yaml 후 수정

poll_interval: 3.0
min_profit_margin: 0.5
total_stake: 100000
max_concurrent_bets: 3
dry_run: true
log_level: INFO

# A사이트: Pinnacle (해외 배당 기준)
site_a:
  name: "Pinnacle"
  enabled: true
  base_url: "https://www.pinnacle.com/ko/"
  adapter: pinnacle
  skip_live: true
  league_filter: []  # 예: ["EPL", "La Liga", "NBA"]

# B사이트: pbc00.com (국내 사이트)
site_b:
  name: "PBC00"
  enabled: true
  base_url: "https://pbc00.com"
  adapter: pbc00
  gamecode: "19"
  game_child_seq: "3659"
  headless: false
  cookies_path: "config/pbc00_session.json"
  username: ""
  password: ""
  selectors: {}

sports:
  - football
  - basketball

markets:
  - moneyline
  - over_under
