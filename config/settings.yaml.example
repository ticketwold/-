# 양방배팅 프로그램 설정

poll_interval: 3.0
min_profit_margin: 0.5
total_stake: 100000
max_concurrent_bets: 3
dry_run: true
log_level: INFO

site_a:
  name: "Pinnacle"
  enabled: true
  base_url: "https://www.pinnacle.com/ko/"
  adapter: pinnacle
  skip_live: true
  league_filter: []
  username: ""
  password: ""

# ★ 종목별 10벳 URL (각 URL = 해당 종목 경기 목록)
site_b:
  name: "PBC00"
  enabled: true
  base_url: "https://pbc00.com"
  adapter: pbc00
  # 레거시 단일 URL (football에 자동 반영됨)
  page_url: "https://pbc00.com/game/newDetail/0?gamecode=19&game_child_seq=3659&event=N"
  gamecode: "19"
  game_child_seq: "3659"
  event: "N"
  headless: false
  cookies_path: "config/pbc00_session.json"
  username: "여기에_pbc00_아이디"
  password: "여기에_pbc00_비밀번호"
  manual_login: true
  skip_tenbet_navigation: true
  manual_tenbet: false
  login_wait_seconds: 180
  selectors: {}
  sport_pages:
    football:
      enabled: true
      gamecode: "19"
      game_child_seq: "3659"
      event: "N"
      page_url: "https://pbc00.com/game/newDetail/0?gamecode=19&game_child_seq=3659&event=N"
    baseball:
      enabled: false
      gamecode: ""
      game_child_seq: ""
      event: "N"
      page_url: ""
    basketball:
      enabled: false
      gamecode: ""
      game_child_seq: ""
      event: "N"
      page_url: ""
    esports:
      enabled: false
      gamecode: ""
      game_child_seq: ""
      event: "N"
      page_url: ""
    tennis:
      enabled: false
      gamecode: ""
      game_child_seq: ""
      event: "N"
      page_url: ""

# 모니터링할 종목 (pbc00 URL이 설정된 종목만 수집됨)
sports:
  - football
  - baseball
  - basketball
  - esports
  - tennis

markets:
  - moneyline
  - over_under
