# 양방배팅 프로그램 설정
# 메모장으로 열어서 본인 정보 입력 후 저장

poll_interval: 3.0
min_profit_margin: 0.5
total_stake: 100000
max_concurrent_bets: 3
dry_run: true          # true=가상배팅만, false=실제배팅(주의!)
log_level: INFO

# ─────────────────────────────────────────────
# A사이트: Pinnacle
# ─────────────────────────────────────────────
# 배당 조회: 로그인 불필요 (자동 API)
# 실제 배팅: username/password 필요 (현재 미지원, 수동 배팅)
site_a:
  name: "Pinnacle"
  enabled: true
  base_url: "https://www.pinnacle.com/ko/"
  adapter: pinnacle
  skip_live: true
  league_filter: []
  username: ""          # 배당만 볼 때는 비워둬도 됨
  password: ""          # 나중에 자동배팅 구현 시 사용

# ─────────────────────────────────────────────
# B사이트: pbc00.com
# ─────────────────────────────────────────────
# 아래 URL로 자동 접속:
# https://pbc00.com/game/newDetail/0?gamecode=19&game_child_seq=3659&event=N
site_b:
  name: "PBC00"
  enabled: true
  base_url: "https://pbc00.com"
  adapter: pbc00

  # 방법1: URL 파라미터 (현재 링크와 동일)
  gamecode: "19"
  game_child_seq: "3659"
  event: "N"

  # 방법2: 전체 URL 직접 지정 (방법1 대신 사용 가능)
  page_url: "https://pbc00.com/game/newDetail/0?gamecode=19&game_child_seq=3659&event=N"

  headless: false
  cookies_path: "config/pbc00_session.json"
  username: "여기에_pbc00_아이디"
  password: "여기에_pbc00_비밀번호"

  # 로그인 설정
  manual_login: true          # true=브라우저에서 직접 로그인 (권장)
  login_url: "https://pbc00.com/main"
  login_wait_seconds: 180     # 수동 로그인 대기 시간(초)

  # 10벳 메뉴 진입 (경기 목록이 나오는 화면)
  navigation_texts:
    - "10벳"
    - "10BET"
    - "10bet"

  selectors:
    # 10벳 버튼 셀렉터 (discover 실행 후 수정 가능)
    tenbet_entry: "a:has-text('10벳'), button:has-text('10벳'), a:has-text('10BET')"

sports:
  - football
  - basketball

markets:
  - moneyline
  - over_under
