# 양방배팅 프로그램 설정

poll_interval: 3.0
min_profit_margin: 0.5
total_stake: 100000
max_concurrent_bets: 3
dry_run: true
log_level: INFO

site_a:
  name: "Pinnacle"
  enabled: true
  base_url: "https://www.pinnacle.com/ko/"
  adapter: pinnacle
  skip_live: true
  league_filter: []
  username: ""
  password: ""

# ★ 이 URL = 10벳 경기 목록 (별도 10벳 메뉴 클릭 불필요)
site_b:
  name: "PBC00"
  enabled: true
  base_url: "https://pbc00.com"
  adapter: pbc00
  page_url: "https://pbc00.com/game/newDetail/0?gamecode=19&game_child_seq=3659&event=N"
  gamecode: "19"
  game_child_seq: "3659"
  event: "N"
  headless: false
  cookies_path: "config/pbc00_session.json"
  username: "여기에_pbc00_아이디"
  password: "여기에_pbc00_비밀번호"
  manual_login: true
  skip_tenbet_navigation: true
  manual_tenbet: false
  login_wait_seconds: 180
  selectors: {}

sports:
  - football
  - basketball

markets:
  - moneyline
  - over_under
