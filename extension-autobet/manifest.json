{
  "manifest_version": 3,
  "name": "양방 자동배팅",
  "version": "1.6.1",
  "description": "양방배팅봇 수익 구간 감지 시 텐텐뱃·BC.Game 동시 자동 배팅",
  "permissions": ["storage", "tabs", "scripting", "webNavigation", "windows", "dom"],
  "host_permissions": [
    "*://*.x10x10s.com/*",
    "*://bc.game/*",
    "*://*.bc.game/*",
    "*://*.bti-sports.com/*",
    "*://*.bti-sports.io/*",
    "*://*.live8588.com/*",
    "*://*.fxf774.com/*",
    "*://*.sptpub.com/*",
    "*://*.sptsportscdn.com/*",
    "*://*.cocoesports.com/*",
    "*://*.betby.com/*",
    "*://*.biahosted.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.bti-sports.io/*",
        "*://*.bti-sports.com/*",
        "*://*.x10x10s.com/*",
        "*://*.live8588.com/*",
        "*://*.fxf774.com/*"
      ],
      "js": ["bti_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://bc.game/*",
        "*://*.bc.game/*"
      ],
      "js": ["polymarket_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.x10x10s.com/*", "*://bc.game/*", "*://*.bc.game/*"],
      "js": ["arb_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_betby_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_sports_scrape.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_slip_read.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_sports_scrape.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_slip_read.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "양방 자동배팅 — 클릭 시 패널 창 열기"
  }
}
