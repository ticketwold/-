{
  "manifest_version": 3,
  "name": "양방 자동배팅",
  "version": "1.0.3",
  "description": "양방배팅봇 수익 구간 감지 시 텐텐뱃·Polymarket/BC.Game 동시 자동 배팅",
  "permissions": ["storage", "tabs", "scripting", "webNavigation", "windows"],
  "host_permissions": [
    "*://*.x10x10s.com/*",
    "*://polymarket.com/*",
    "*://*.polymarket.com/*",
    "*://bc.game/*",
    "*://*.bc.game/*",
    "*://gamma-api.polymarket.com/*",
    "*://*.bti-sports.com/*",
    "*://*.bti-sports.io/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bti-sports.io/*", "*://*.bti-sports.com/*", "*://*.x10x10s.com/*"],
      "js": ["bti_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://polymarket.com/*",
        "*://*.polymarket.com/*",
        "*://bc.game/*",
        "*://*.bc.game/*"
      ],
      "js": ["polymarket_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.x10x10s.com/*", "*://polymarket.com/*", "*://*.polymarket.com/*", "*://bc.game/*", "*://*.bc.game/*"],
      "js": ["arb_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "양방 자동배팅",
    "default_popup": "panel.html"
  }
}
