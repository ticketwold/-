{
  "manifest_version": 3,
  "name": "양방 자동배팅",
  "version": "2.5.4",
  "description": "텐텐뱃·BC.Game·Stake.com 양방 자동배팅 — 배당 스캔·금액 동기화",
  "incognito": "spanning",
  "permissions": ["storage", "tabs", "scripting", "webNavigation", "windows", "dom"],
  "host_permissions": [
    "*://*.x10x10s.com/*",
    "*://bc.game/*",
    "*://*.bc.game/*",
    "*://stake.com/*",
    "*://*.stake.com/*",
    "*://*.bti-sports.com/*",
    "*://*.bti-sports.io/*",
    "*://*.live8588.com/*",
    "*://*.fxf774.com/*",
    "*://*.pbc00.com/*",
    "*://*.sptpub.com/*",
    "*://*.sptsportscdn.com/*",
    "*://*.cocoesports.com/*",
    "*://*.betby.com/*",
    "*://*.biahosted.com/*",
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://x10x10s.com/*",
        "*://www.x10x10s.com/*",
        "*://*.bti-sports.io/*",
        "*://*.bti-sports.com/*",
        "*://*.x10x10s.com/*",
        "*://*.live8588.com/*",
        "*://*.fxf774.com/*",
        "*://*.pbc00.com/*",
        "*://*.v210x10b.com/*",
        "*://v210x10b.com/*",
        "*://*.y10x103.com/*",
        "*://y10x103.com/*",
        "*://*.v210x10g.com/*",
        "*://v210x10g.com/*",
        "*://*.z10x104.com/*",
        "*://z10x104.com/*",
        "*://*.streambridge.feedconstruct.com/*",
        "*://streambridge.feedconstruct.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.biahosted.com/*",
        "*://*.cocoesports.com/*"
      ],
      "js": ["bti_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://x10x10s.com/*",
        "*://www.x10x10s.com/*",
        "*://*.bti-sports.io/*",
        "*://*.bti-sports.com/*",
        "*://*.x10x10s.com/*",
        "*://*.live8588.com/*",
        "*://*.fxf774.com/*",
        "*://*.pbc00.com/*",
        "*://*.v210x10b.com/*",
        "*://v210x10b.com/*",
        "*://*.y10x103.com/*",
        "*://y10x103.com/*",
        "*://*.v210x10g.com/*",
        "*://v210x10g.com/*",
        "*://*.z10x104.com/*",
        "*://z10x104.com/*",
        "*://*.streambridge.feedconstruct.com/*",
        "*://streambridge.feedconstruct.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.biahosted.com/*",
        "*://*.cocoesports.com/*"
      ],
      "js": ["bti_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://bc.game/*",
        "*://*.bc.game/*"
      ],
      "js": ["polymarket_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://stake.com/*",
        "*://*.stake.com/*"
      ],
      "js": ["stake_slip_read.js", "stake_content.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": ["*://*.x10x10s.com/*", "*://*.live8588.com/*", "*://*.fxf774.com/*", "*://*.pbc00.com/*", "*://*.v210x10b.com/*", "*://*.y10x103.com/*", "*://*.v210x10g.com/*", "*://*.z10x104.com/*", "*://bc.game/*", "*://*.bc.game/*", "*://stake.com/*", "*://*.stake.com/*"],
      "js": ["arb_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://stake.com/*", "*://*.stake.com/*"],
      "js": ["stake_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_betby_bridge.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_sports_scrape.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://bc.game/*", "*://*.bc.game/*"],
      "js": ["bc_slip_read.js"],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_api_hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_sports_scrape.js"],
      "run_at": "document_idle",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "*://*.betby.com/*",
        "*://*.sptpub.com/*",
        "*://*.sptsportscdn.com/*",
        "*://*.cocoesports.com/*",
        "*://*.biahosted.com/*"
      ],
      "js": ["bc_slip_read.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_title": "양방 자동배팅 — 클릭 시 패널 창 열기"
  }
}
